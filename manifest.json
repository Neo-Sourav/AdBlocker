{
  "manifest_version": 3,
  "name": "Course Focus & Ad Blocker",
  "version": "2.0",
  "description": "Prevents video pauses and blocks common ads/trackers.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_block_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["hide-ads.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}